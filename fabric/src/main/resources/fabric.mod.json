{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/tarotcards-remastered",
    "sources": "https://github.com/Suel-ki/TarotCards-Remastered",
    "issues": "https://github.com/Suel-ki/TarotCards-Remastered/issues"
  },
  "license": "${license}",
  "icon": "assets/tarotcards/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.suel_ki.tarotcards.fabric.TarotCardsFabric"
    ],
    "client": [
      "io.github.suel_ki.tarotcards.client.fabric.ClientTarotCards"
    ]
  },
  "mixins": [
    "tarotcards-common.mixins.json",
    "tarotcards.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "minecraft": ">=1.21.1",
    "fzzy_config": "*"
  }
}